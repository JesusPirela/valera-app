-- ⚠️ ESTE ARCHIVO NO SE APLICA SOLO. Hay que pegarlo en el SQL Editor de
--    Supabase a mano.
--
-- Enciende la alarma insistente de LEADS DE CAMPAÑA: cada 5 minutos, entre
-- 8am y 9pm hora de México, hasta que la persona contacte o posponga.
--
-- ── A quién le suena hoy ────────────────────────────────────────────────────
-- Medido el 8/oct/2026, ya con las retros apagadas (ver
-- 20261030_alarma_solo_leads.sql):
--
--   Alexis Plus (gerente) ... 1 lead  ← el de prueba, y nadie más
--
-- O sea: encenderlo ahora mismo no molesta a ningún asesor real. El último
-- lead de campaña de verdad entró el 19/ago/2026, así que hasta que vuelvan a
-- llegar leads esto solo suena en pruebas.
--
-- ── Cómo apagarlo ───────────────────────────────────────────────────────────
--   UPDATE cron.job SET active = false WHERE jobname = 'generar-alarmas';
--
-- ── Qué calla la alarma, del lado de la persona ─────────────────────────────
--   · Picarle a WhatsApp o a Llamar en "Leads de campaña" (sube wa_count o
--     call_count, y la alarma exige los dos en cero).
--   · El botón Posponer, que da una hora de silencio.
--   Abrir la app NO basta, a propósito.

SELECT cron.unschedule('generar-alarmas')
 WHERE EXISTS (SELECT 1 FROM cron.job WHERE jobname = 'generar-alarmas');

SELECT cron.schedule('generar-alarmas', '*/5 * * * *', $cron$
  SELECT public.generar_alarmas();
$cron$);

-- Comprobación.
SELECT jobname, schedule, active FROM cron.job WHERE jobname = 'generar-alarmas';
