{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Resuelve los módulos con split por plataforma (MiniMapa.web.tsx, etc.):
    // tsc typechequea la variante .web; Metro sigue eligiendo por plataforma.
    "moduleSuffixes": [".web", ""]
  },
  // Las edge functions y los scripts sueltos corren en Deno (imports por URL,
  // global Deno): tienen su propio runtime y se despliegan aparte — fuera del
  // typecheck del app. Sin excluir supabase/scripts, convertir-fotos-wa.ts
  // tumbaba el typecheck de CI con 5 "Cannot find name 'Deno'".
  "exclude": ["node_modules", "supabase/functions", "supabase/scripts"]
}
